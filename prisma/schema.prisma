generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model assignments {
  assignment_id                        BigInt                @id @default(autoincrement())
  grievance_id                         BigInt
  grievance_department_id              BigInt                @unique(map: "uq_active_assignment", where: raw("((assignment_status)::text = 'ASSIGNED'::text)"))
  staff_id                             BigInt
  recommendation_score                 Decimal?              @db.Decimal(5, 2)
  recommendation_reasons               Json?
  assignment_status                    String                @default("ASSIGNED") @db.VarChar(30)
  assigned_by                          BigInt
  assigned_at                          DateTime              @default(now()) @db.Timestamptz(6)
  completed_at                         DateTime?             @db.Timestamptz(6)
  users_assignments_assigned_byTousers users                 @relation("assignments_assigned_byTousers", fields: [assigned_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  grievance_departments                grievance_departments @relation(fields: [grievance_department_id], references: [grievance_department_id], onDelete: Cascade, onUpdate: NoAction)
  grievances                           grievances            @relation(fields: [grievance_id], references: [grievance_id], onDelete: Cascade, onUpdate: NoAction)
  users_assignments_staff_idTousers    users                 @relation("assignments_staff_idTousers", fields: [staff_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([grievance_id], map: "idx_assignments_grievance_id")
  @@index([staff_id], map: "idx_assignments_staff_id")
  @@index([staff_id, assignment_status], map: "idx_assignments_staff_status")
  @@index([assignment_status], map: "idx_assignments_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attachments {
  attachment_id           BigInt                 @id @default(autoincrement())
  grievance_id            BigInt
  grievance_department_id BigInt?
  file_name               String                 @db.VarChar(255)
  file_path               String                 @db.VarChar(500)
  file_type               String                 @db.VarChar(100)
  file_size               BigInt?
  uploaded_by             BigInt
  uploaded_at             DateTime               @default(now()) @db.Timestamptz(6)
  resolution_id           BigInt?
  grievance_departments   grievance_departments? @relation(fields: [grievance_department_id], references: [grievance_department_id], onUpdate: NoAction)
  grievances              grievances             @relation(fields: [grievance_id], references: [grievance_id], onDelete: Cascade, onUpdate: NoAction)
  resolutions             resolutions?           @relation(fields: [resolution_id], references: [resolution_id], onUpdate: NoAction)
  users                   users                  @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([grievance_id], map: "idx_attachments_grievance_id")
  @@index([resolution_id], map: "idx_attachments_resolution_id")
}

model audit_logs {
  audit_log_id BigInt      @id @default(autoincrement())
  user_id      BigInt?
  grievance_id BigInt?
  action       String      @db.VarChar(100)
  entity_type  String      @db.VarChar(50)
  entity_id    BigInt?
  old_value    Json?
  new_value    Json?
  ip_address   String?     @db.VarChar(45)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  grievances   grievances? @relation(fields: [grievance_id], references: [grievance_id], onDelete: Cascade, onUpdate: NoAction)
  users        users?      @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)

  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([grievance_id], map: "idx_audit_logs_grievance_id")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  category_id        BigInt               @id @default(autoincrement())
  category_name      String               @unique @db.VarChar(150)
  description        String?              @db.VarChar(255)
  status             String               @default("ACTIVE") @db.VarChar(20)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  grievances         grievances[]
  knowledge_articles knowledge_articles[]
  routing_rules      routing_rules[]
  subcategories      subcategories[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model departments {
  department_id         BigInt                  @id @default(autoincrement())
  department_name       String                  @unique @db.VarChar(100)
  description           String?                 @db.VarChar(255)
  status                String                  @default("ACTIVE") @db.VarChar(20)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  grievance_departments grievance_departments[]
  routing_rules         routing_rules[]
  users                 users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model escalations {
  escalation_id    BigInt        @id @default(autoincrement())
  grievance_id     BigInt
  sla_policy_id    BigInt?
  escalation_level Int           @default(1)
  escalated_to     BigInt
  reason           String
  status           String        @default("OPEN") @db.VarChar(20)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  resolved_at      DateTime?     @db.Timestamptz(6)
  users            users         @relation(fields: [escalated_to], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  grievances       grievances    @relation(fields: [grievance_id], references: [grievance_id], onDelete: Cascade, onUpdate: NoAction)
  sla_policies     sla_policies? @relation(fields: [sla_policy_id], references: [sla_policy_id], onUpdate: NoAction)

  @@index([grievance_id], map: "idx_escalations_grievance_id")
  @@index([status], map: "idx_escalations_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model grievance_departments {
  grievance_department_id BigInt        @id @default(autoincrement())
  grievance_id            BigInt        @unique(map: "uq_grievance_single_primary", where: raw("((involvement_type)::text = 'PRIMARY'::text)"))
  department_id           BigInt
  involvement_type        String        @db.VarChar(20)
  status                  String        @default("PENDING_ASSIGNMENT") @db.VarChar(30)
  assigned_at             DateTime?     @db.Timestamptz(6)
  completed_at            DateTime?     @db.Timestamptz(6)
  assignments             assignments?
  attachments             attachments[]
  departments             departments   @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction)
  grievances              grievances    @relation(fields: [grievance_id], references: [grievance_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([grievance_id, department_id], map: "uq_grievance_department")
  @@index([department_id], map: "idx_grievance_dept_dept_id")
  @@index([department_id, status], map: "idx_grievance_dept_dept_status")
  @@index([grievance_id], map: "idx_grievance_dept_grievance_id")
  @@index([status], map: "idx_grievance_dept_status")
}

model grievance_status_history {
  history_id   BigInt     @id @default(autoincrement())
  grievance_id BigInt
  old_status   String?    @db.VarChar(30)
  new_status   String     @db.VarChar(30)
  changed_by   BigInt
  remarks      String?
  changed_at   DateTime   @default(now()) @db.Timestamptz(6)
  users        users      @relation(fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  grievances   grievances @relation(fields: [grievance_id], references: [grievance_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model grievances {
  grievance_id             BigInt                     @id @default(autoincrement())
  grievance_number         String                     @unique @db.VarChar(50)
  submitted_by             BigInt
  category_id              BigInt
  subcategory_id           BigInt
  title                    String                     @db.VarChar(200)
  description              String
  priority                 String                     @db.VarChar(20)
  priority_rule_id         BigInt?
  status                   String                     @default("SUBMITTED") @db.VarChar(30)
  reopen_count             Int                        @default(0)
  manual_review_count      Int                        @default(0)
  sla_status               String?                    @db.VarChar(20)
  due_at                   DateTime?                  @db.Timestamptz(6)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  closed_at                DateTime?                  @db.Timestamptz(6)
  assignments              assignments[]
  attachments              attachments[]
  audit_logs               audit_logs[]
  escalations              escalations[]
  grievance_departments    grievance_departments?
  grievance_status_history grievance_status_history[]
  categories               categories                 @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  priority_rules           priority_rules?            @relation(fields: [priority_rule_id], references: [priority_rule_id], onUpdate: NoAction)
  subcategories            subcategories              @relation(fields: [subcategory_id], references: [subcategory_id], onDelete: NoAction, onUpdate: NoAction)
  users                    users                      @relation(fields: [submitted_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  notifications            notifications[]
  resolutions              resolutions[]
  sla_tracking             sla_tracking[]

  @@index([category_id], map: "idx_grievances_category_id")
  @@index([created_at], map: "idx_grievances_created_at")
  @@index([priority], map: "idx_grievances_priority")
  @@index([status], map: "idx_grievances_status")
  @@index([submitted_by], map: "idx_grievances_submitted_by")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
